# libFuzzer dictionary for the terminal byte-stream targets.
#
# Shared by `ansi_parser` and `terminal_state` (see `dictionary_for_target` in
# xtask/src/fuzz/dictionary.rs). Tokens are the introducers, finals and
# parameter prefixes that gate the parser's state machine, so the fuzzer can
# splice them instead of rediscovering them byte by byte.
#
# Format: one `"token"` per line (optionally `name="token"`), `\xNN` escapes,
# `\\` and `\"` for backslash and quote, `#` starts a comment. ESC is \x1b.

# --- C0 controls ---------------------------------------------------------
c0_bel="\x07"
c0_bs="\x08"
c0_ht="\x09"
c0_lf="\x0a"
c0_vt="\x0b"
c0_ff="\x0c"
c0_cr="\x0d"
c0_so="\x0e"
c0_si="\x0f"
c0_can="\x18"
c0_sub="\x1a"
c0_esc="\x1b"
c0_del="\x7f"

# --- C1 8-bit introducers (bare bytes, as a legacy 8-bit stream sends them)
c1_ind="\x84"
c1_nel="\x85"
c1_hts="\x88"
c1_ri="\x8d"
c1_dcs="\x90"
c1_csi="\x9b"
c1_st="\x9c"
c1_osc="\x9d"
c1_pm="\x9e"
c1_apc="\x9f"

# --- 7-bit introducers and simple escapes ---------------------------------
esc_csi="\x1b["
esc_osc="\x1b]"
esc_dcs="\x1bP"
esc_apc="\x1b_"
esc_pm="\x1b^"
esc_st="\x1b\\"
esc_hash="\x1b#"
esc_g0="\x1b("
esc_g1="\x1b)"
esc_decsc="\x1b7"
esc_decrc="\x1b8"
esc_ris="\x1bc"

# --- CSI: modes, with parameters ------------------------------------------
csi_alt_screen_on="\x1b[?1049h"
csi_alt_screen_off="\x1b[?1049l"
csi_bracketed_paste="\x1b[?2004h"
csi_declrmm_on="\x1b[?69h"
csi_autowrap_off="\x1b[?7l"
csi_cursor_hide="\x1b[?25l"
csi_mouse_x11="\x1b[?1000h"
csi_mouse_sgr="\x1b[?1006h"
csi_sync_update="\x1b[?2026h"

# --- CSI: margins, erase, cursor, reports ---------------------------------
csi_decstbm="\x1b[r"
csi_save_cursor="\x1b[s"
csi_ed_all="\x1b[2J"
csi_el="\x1b[K"
csi_home="\x1b[H"
csi_da1="\x1b[c"
csi_da2="\x1b[>c"
csi_dsr="\x1b[6n"
csi_rep="\x1b[b"
csi_cbt="\x1b[Z"
csi_cht="\x1b[I"

# --- CSI: SGR --------------------------------------------------------------
csi_sgr_truecolor_fg="\x1b[38;2;"
csi_sgr_256_bg="\x1b[48;5;"
csi_sgr_reset="\x1b[0m"

# --- CSI: XTWINOPS and kitty keyboard -------------------------------------
csi_xtwinops="\x1b[t"
csi_xtwinops_resize="\x1b[8;"
csi_xtwinops_push_title="\x1b[22;0t"
csi_kitty_kbd_push="\x1b[>1u"
csi_kitty_kbd_query="\x1b[?u"

# --- DEC line attributes ---------------------------------------------------
dec_decdhl_top="\x1b#3"
dec_decdwl="\x1b#6"
dec_decaln="\x1b#8"

# --- OSC openers -----------------------------------------------------------
osc_icon_title="\x1b]0;"
osc_title="\x1b]2;"
osc_cwd="\x1b]7;file://"
osc_hyperlink="\x1b]8;;"
osc_clipboard="\x1b]52;c;"
osc_kitty_notify="\x1b]99;"
osc_shell_integration="\x1b]133;A"
osc_iterm_file="\x1b]1337;File="
osc_histfile="\x1b]1338;HISTFILE="
osc_pointer_shape="\x1b]22;"

# --- DCS -------------------------------------------------------------------
dcs_xtgettcap="\x1bP+q"
dcs_decrqss="\x1bP$q"
dcs_sixel="\x1bPq"
dcs_tmux_passthrough="\x1bPtmux;"

# --- APC: kitty graphics ---------------------------------------------------
apc_kitty_transmit_display="\x1b_Ga=T,"
apc_kitty_delete="\x1b_Gt=d,"
kitty_format_png="f=100"
kitty_more_chunks="m=1"

# --- Sixel body tokens -----------------------------------------------------
sixel_raster="\"1;1;"
sixel_colour_def="#0;2;"
sixel_repeat="!"
sixel_cr="$"
sixel_lf="-"

# --- UTF-8: wide, combining, emoji, ZWJ -----------------------------------
utf8_wide_cjk="\xe4\xb8\xad"
utf8_combining_acute="\xcc\x81"
utf8_emoji="\xf0\x9f\x98\x80"
utf8_zwj="\xe2\x80\x8d"
